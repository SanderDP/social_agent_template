# Kopieer naar .env en vul zelf in. .env staat in .gitignore en gaat nooit naar GitHub.
# In de cloud-routine worden deze NIET als bestand gebruikt maar als "network secret"
# op de cloud-omgeving (zie docs/). Plak deze waarden nooit in de chat.

# Pexels (gratis): https://www.pexels.com/api/
PEXELS_API_KEY=

# Instagram API with Instagram Login (stappenplan volgt in Fase 2)
IG_USER_ID=
IG_ACCESS_TOKEN=

# TikTok Display API (later, zodra het account er is)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
